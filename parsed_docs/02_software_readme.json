2, 93, 94, 95, 96, 97, 98, 99], "seq_ids": [0], "token_class": "CCCCCCCCCCCCMCMC"}, {"id": "n6", "node_type": "code_block", "parent": "n4", "children": [], "depth": 4, "title": "", "path": "quillsync > Installation > From a release", "attrs": {"language": "bash", "fenced": true}, "unit": "u3", "text": "```bash\ncurl -LO https://example.org/quillsync/v2.4.1/quillsync-linux-amd64.tar.gz\ntar -xzf quillsync-linux-amd64.tar.gz\nsudo mv quillsync /usr/local/bin/\n```\n\n", "tokens": [74694, 47316, 198, 20520, 482, 1623, 3788, 1129, 8858, 2726, 79945, 3385, 1756, 5574, 17, 13, 19, 13, 16, 79945, 3385, 1756, 47475, 33317, 67, 1227, 29148, 21637, 198, 27835, 482, 87, 70494, 934, 3385, 1756, 47475, 33317, 67, 1227, 29148, 21637, 198, 19413, 24039, 934, 3385, 1756, 611, 7208, 23066, 8923, 6018, 14196, 19884], "positions": [100, 101, 102, 103, 104, 105, 106, 107, 108, 109, 110, 111, 112, 113, 114, 115, 116, 117, 118, 119, 120, 121, 122, 123, 124, 125, 126, 127, 128, 129, 130, 131, 132, 133, 134, 135, 136, 137, 138, 139, 140, 141, 142, 143, 144, 145, 146, 147, 148, 149, 150, 151, 152, 153, 154], "seq_ids": [0], "token_class": "MMWCCCCCCCCCCCCCCCCCCCCCCCCCWCCCCCCCCCCCCCWCCCCCCCCCCMM"}, {"id": "n7", "node_type": "paragraph", "parent": "n4", "children": [], "depth": 4, "title": "", "path": "quillsync > Installation > From a release", "attrs": {}, "unit": "u3", "text": "The current stable release is **version 2.4.1**, published on 3 March 2026.\n\n", "tokens": [791, 1510, 15528, 4984, 374, 3146, 4464, 220, 17, 13, 19, 13, 16, 98319, 4756, 389, 220, 18, 5587, 220, 2366, 21, 382], "positions": [155, 156, 157, 158, 159, 160, 161, 162, 163, 164, 165, 166, 167, 168, 169, 170, 171, 172, 173, 174, 175, 176, 177], "seq_ids": [0], "token_class": "CCCCCMCWCCCCCCCCWCCWCCC"}, {"id": "n8", "node_type": "heading", "parent": "n3", "children": ["n9", "n10"], "depth": 3, "title": "From source", "path": "quillsync > Installation > From source", "attrs": {"level": 3}, "unit": "u4", "text": "### From source\n\n", "tokens": [14711, 5659, 2592, 271], "positions": [79, 80, 81, 82], "seq_ids": [1], "token_class": "MCCW"}, {"id": "n9", "node_type": "paragraph", "parent": "n8", "children": [], "depth": 4, "title": "", "path": "quillsync > Installation > From source", "attrs": {}, "unit": "u4", "text": "Building from source requires Go 1.22 or newer:\n\n", "tokens": [31233, 505, 2592, 7612, 6122, 220, 16, 13, 1313, 477, 26627, 1473], "positions": [83, 84, 85, 86, 87, 88, 89, 90, 91, 92, 93, 94], "seq_ids": [1], "token_class": "CCCCCWCCCCCC"}, {"id": "n10", "node_type": "code_block", "parent": "n8", "children": [], "depth": 4, "title": "", "path": "quillsync > Installation > From source", "attrs": {"language": "bash", "fenced": true}, "unit": "u4", "text": "```bash\ngit clone https://example.org/quillsync.git\ncd quillsync\nmake build\n```\n\n", "tokens": [74694, 47316, 198, 13178, 15057, 3788, 1129, 8858, 2726, 79945, 3385, 1756, 33899, 198, 4484, 934, 3385, 1756, 198, 7072, 1977, 198, 14196, 19884], "positions": [95, 96, 97, 98, 99, 100, 101, 102, 103, 104, 105, 106, 107, 108, 109, 110, 111, 112, 113, 114, 115, 116, 117, 118], "seq_ids": [1], "token_class": "MMWCCCCCCCCCCWCCCCWCCWMM"}, {"id": "n11", "node_type": "heading", "parent": "n1", "children": ["n12", "n13", "n14"], "depth": 2, "title": "Configuration", "path": "quillsync > Configuration", "attrs": {"level": 2}, "unit": "u5", "text": "## Configuration\n\n", "tokens": [567, 12499, 271], "positions": [76, 77, 78], "seq_ids": [2], "token_class": "MCW"}, {"id": "n12", "node_type": "paragraph", "parent": "n11", "children": [], "depth": 3, "title": "", "path": "quillsync > Configuration", "attrs": {}, "unit": "u5", "text": "The configuration file lives at `~/.config/quillsync/config.yaml`:\n\n", "tokens": [791, 6683, 1052, 6439, 520, 1595, 93, 12196, 1710, 79945, 3385, 1756, 15072, 34506, 63, 1473], "positions": [79, 80, 81, 82, 83, 84, 85, 86, 87, 88, 89, 90, 91, 92, 93, 94], "seq_ids": [2], "token_class": "CCCCCMCC